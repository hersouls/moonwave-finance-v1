rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 소유자 검증 — 각 사용자는 자기 uid 서브트리만 읽고 쓸 수 있다.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── 가족 허용 목록 ──────────────────────────────────────────────
    // 이 목록에 없는 Google 계정은 로그인해도 아무것도 읽고 쓸 수 없다 —
    // 외부 계정이 자기 uid 아래 무제한 쓰기로 공유 무료 쿼터를 소모하는
    // 것을 차단한다 (실제 쿼터 소진 이력 있음).
    // 가족 구성원이 늘면: Firebase Console → Authentication → Users에서
    // UID를 복사해 아래 배열에 추가하고 rules만 재배포한다:
    //   npx firebase-tools deploy --only firestore:rules
    function isFamily() {
      return request.auth != null && request.auth.uid in [
        'i8jGN5WfenY369OMdjZ4u30UVfB3' // deasoung@gmail.com
      ];
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) && isFamily();
    }
  }
}
